      "name": "Combine Lead + Research"
    },
    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "def esc(value):\n    if value is None:\n        return \"\"\n    text = str(value)\n    return (\n        text.replace(\"&\", \"&amp;\")\n        .replace(\"<\", \"&lt;\")\n        .replace(\">\", \"&gt;\")\n        .replace('\"', \"&quot;\")\n        .replace(\"'\", \"&#39;\")\n    )\n\ndef list_html(values, empty_text=\"None identified\"):\n    if not values:\n        return \"<p>\" + esc(empty_text) + \"</p>\"\n    return \"<ul>\" + \"\".join(\"<li>\" + esc(v) + \"</li>\" for v in values) + \"</ul>\"\n\nneed_points = {\n    \"specific\": 20,\n    \"general\": 10,\n    \"none\": 0,\n}\n\nbudget_points = {\n    \"approved_reserved\": 25,\n    \"available_not_fixed\": 18,\n    \"unknown\": 8,\n    \"unavailable\": 0,\n}\n\ntimeline_points = {\n    \"within_1_month\": 20,\n    \"few_months\": 15,\n    \"within_12_months\": 10,\n    \"next_year_or_vague\": 5,\n    \"none\": 0,\n}\n\nengagement_points = {\n    \"proposal_requested\": 15,\n    \"concrete_follow_up\": 12,\n    \"materials_or_info_requested\": 8,\n    \"casual_interest\": 4,\n    \"none\": 0,\n}\n\noutputs = []\n\nfor item in _items:\n    row = item[\"json\"]\n\n    need_score = need_points.get(row.get(\"need_status\", \"none\"), 0)\n    budget_score = budget_points.get(row.get(\"budget_status\", \"unknown\"), 8)\n    timeline_score = timeline_points.get(row.get(\"timeline_status\", \"none\"), 0)\n    engagement_score = engagement_points.get(row.get(\"engagement_status\", \"none\"), 0)\n\n    employees = row.get(\"approximate_employees\") or 0\n    scope_status = row.get(\"scope_status\", \"unknown\")\n\n    if scope_status == \"large_multi_country_or_100plus\":\n        scope_score = 20\n    elif scope_status == \"small_company_under_10\":\n        scope_score = 0\n    elif employees >= 1000:\n        scope_score = 20\n    elif employees >= 250:\n        scope_score = 15\n    elif employees >= 50:\n        scope_score = 10\n    elif employees >= 10:\n        scope_score = 5\n    elif employees > 0:\n        scope_score = 0\n    elif scope_status == \"medium_or_multi_team\":\n        scope_score = 12\n    else:\n        scope_score = 8\n\n    total = need_score + budget_score + timeline_score + scope_score + engagement_score\n\n    if total >= 75:\n        temperature = \"Hot\"\n    elif total >= 50:\n        temperature = \"Warm\"\n    else:\n        temperature = \"Cold\"\n\n    score_reasons = [\n        \"Training need: +\" + str(need_score),\n        \"Budget signal: +\" + str(budget_score),\n        \"Timing: +\" + str(timeline_score),\n        \"Company size / scope: +\" + str(scope_score),\n        \"Engagement / next step: +\" + str(engagement_score),\n    ]\n\n    requested = row.get(\"requested_follow_up\") or \"Unknown\"\n    if requested != \"Unknown\":\n        recommended_next_step = requested\n    elif temperature == \"Hot\":\n        recommended_next_step = \"Schedule a discovery call within one week.\"\n    elif temperature == \"Warm\":\n        recommended_next_step = \"Send relevant case studies and agree a follow-up date.\"\n    else:\n        recommended_next_step = \"Send a general overview and add the lead to a nurture list.\"\n\n    issues = row.get(\"legal_regulatory_reputational_issues\") or []\n    if issues:\n        issues_html = list_html(issues)\n    else:\n        issues_html = \"<p>No significant issue surfaced in the retrieved search results. This does not prove that none exist.</p>\"\n\n    sources = row.get(\"source_urls\") or []\n    if sources:\n        source_items = []\n        for url in sources:\n            safe_url = esc(url)\n            source_items.append('<li><a href=\"' + safe_url + '\">' + safe_url + \"</a></li>\")\n        sources_html = \"<ul>\" + \"\".join(source_items) + \"</ul>\"\n    else:\n        sources_html = \"<p>No source URLs were extracted.</p>\"\n\n    uncertainties = row.get(\"uncertainties\") or []\n    uncertainty_html = list_html(uncertainties, \"No uncertainty explicitly noted in the meeting notes.\")\n\n    company = row.get(\"company_name\", \"Unknown company\")\n    contact = row.get(\"contact_name\", \"Unknown\")\n    role = row.get(\"role\", \"Unknown\")\n    email = row.get(\"email\", \"Unknown\")\n\n    email_subject = \"Trade Fair Lead Report | \" + company + \" | \" + str(total) + \"/100 \" + temperature\n\n    email_html = f\"\"\"\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:760px;margin:0 auto;color:#222;line-height:1.5\">\n  <h1 style=\"font-size:24px;margin-bottom:6px\">Trade Fair Lead Report</h1>\n  <p style=\"margin-top:0;color:#666\">{esc(company)}</p>\n\n  <div style=\"padding:16px;border:1px solid #ddd;border-radius:10px;margin:20px 0\">\n    <h2 style=\"margin-top:0;font-size:18px\">Contact</h2>\n    <p>\n      <strong>{esc(contact)}</strong><br>\n      {esc(role)}<br>\n      {esc(email)}\n    </p>\n  </div>\n\n  <div style=\"padding:16px;border:1px solid #ddd;border-radius:10px;margin:20px 0\">\n    <h2 style=\"margin-top:0;font-size:18px\">Lead score</h2>\n    <p style=\"font-size:28px;margin:0\"><strong>{total}/100</strong> - {esc(temperature)}</p>\n  </div>\n\n  <h2 style=\"font-size:18px\">Opportunity summary</h2>\n  <p>{esc(row.get(\"notes_summary\", \"Unknown\"))}</p>\n\n  <h2 style=\"font-size:18px\">Training interests</h2>\n  {list_html(row.get(\"training_needs\") or [])}\n\n  <h2 style=\"font-size:18px\">Pain points</h2>\n  {list_html(row.get(\"pain_points\") or [])}\n\n  <h2 style=\"font-size:18px\">Budget and timing</h2>\n  <p>\n    <strong>Budget:</strong> {esc(row.get(\"budget_status\", \"unknown\"))}<br>\n    <strong>Timing:</strong> {esc(row.get(\"timeline_text\", \"Unknown\"))}\n  </p>\n\n  <h2 style=\"font-size:18px\">Company background</h2>\n  <p>{esc(row.get(\"company_description\", \"Unknown\"))}</p>\n  <p>\n    <strong>Headquarters:</strong> {esc(row.get(\"headquarters\", \"Unknown\"))}<br>\n    <strong>Approx. employees:</strong> {esc(employees if employees else \"Unknown\")}<br>\n    <strong>Employee-count note:</strong> {esc(row.get(\"employee_count_source_note\", \"Unknown\"))}<br>\n    <strong>Geographic presence:</strong> {esc(row.get(\"geographic_presence\", \"Unknown\"))}\n  </p>\n\n  <h3 style=\"font-size:16px\">Products / services</h3>\n  {list_html(row.get(\"products_services\") or [])}\n\n  <h3 style=\"font-size:16px\">Publicly reported legal / regulatory / reputational issues</h3>\n  {issues_html}\n\n  <h2 style=\"font-size:18px\">Why this score</h2>\n  {list_html(score_reasons)}\n\n  <h2 style=\"font-size:18px\">Recommended next step</h2>\n  <p>{esc(recommended_next_step)}</p>\n\n  <h2 style=\"font-size:18px\">Data quality / uncertainty</h2>\n  {uncertainty_html}\n\n  <h2 style=\"font-size:18px\">Sources</h2>\n  {sources_html}\n\n  <hr style=\"border:none;border-top:1px solid #ddd;margin:24px 0\">\n  <p style=\"font-size:12px;color:#777\">\n    Prototype generated from salesperson notes plus public web research. Company research should be reviewed before being used for an important sales decision.\n  </p>\n</div>\n\"\"\"\n\n    result = dict(row)\n    result[\"lead_score\"] = total\n    result[\"lead_temperature\"] = temperature\n    result[\"score_reasons\"] = score_reasons\n    result[\"recommended_next_step\"] = recommended_next_step\n    result[\"email_subject\"] = email_subject\n    result[\"email_html\"] = email_html\n\n    outputs.append({\"json\": result})\n\nreturn outputs"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
