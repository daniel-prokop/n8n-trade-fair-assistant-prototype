        "jsonBody": "={{ { \"query\": \"Research this company for a B2B training sales lead: \" + $json.output.company_name + \". Find the current company description, headquarters, approximate employee count, main products/services, countries or regions of operation, and any significant publicly documented legal, regulatory, or reputational issues. Prefer official company pages, reputable business sources, and major news outlets. Do not speculate. Include evidence and source URLs.\", \"search_depth\": \"advanced\", \"max_results\": 6, \"topic\": \"general\", \"include_answer\": \"advanced\", \"include_raw_content\": false, \"safe_search\": true } }}",
        "options": {
          "timeout": 30000
        }
